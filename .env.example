# Server Configuration
PORT=5001
NODE_ENV=production
RUN_WORKERS=true

# Database & Authentication
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dfl_db?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key
ENCRYPTION_KEY=your_32_byte_encryption_key

# Redis Configuration (For production BullMQ & Socket.io)
BYPASS_REDIS=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# URLs & Allowed Origins
BACKEND_URL=https://api.thedflgroup.com
FRONTEND_URL=https://express.thedflgroup.com
CLIENT_URL=https://express.thedflgroup.com
ADMIN_PORTAL_URL=https://admin.thedflgroup.com
CUSTOMER_PORTAL_URL=https://express.thedflgroup.com
FRANCHISE_PORTAL_URL=https://franchise.thedflgroup.com

# Payment Gateways (Cashfree)
CASHFREE_ENV=PRODUCTION
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Email Services (SMTP & Brevo)
SMTP_SERVICE=
SMTP_EMAIL=
SMTP_PASSWORD=
RECEIVER_EMAIL=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_ENABLED=true

# Carrier Integrations (Skynet, TPL, RSA, AWCC, Willow, Envia)
SKYNET_EMAIL=
SKYNET_PASSWORD=
TPL_USERNAME=
TPL_PASSWORD=
TPL_API_KEY=
RSA_ENV=LIVE
ENVIA_API_TOKEN=
WILLOW_COMMERCE_LIVE_API_KEY=
